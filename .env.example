DJANGO_SECRET_KEY=uzun-tasodifiy-qiymat
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=tttaudit.uz,www.tttaudit.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://tttaudit.uz,https://www.tttaudit.uz
SITE_URL=https://tttaudit.uz
# DATABASE_URL=postgresql://user:parol@host:5432/tttaudit
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Teskari proksi X-Real-IP ni qayta yozsa (Railway, nginx): 1
TRUST_X_REAL_IP=0
# Railway: volume /app/media ga ulanadi; boshqa joy boʻlsa
# DJANGO_MEDIA_ROOT=/data/media
# gunicorn worker soni
# WEB_CONCURRENCY=3
# HSTS: domen faqat HTTPS ekani tasdiqlangach 31536000 ga koʻtaring
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0
